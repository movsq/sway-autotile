#!/usr/bin/env bash
# tests/run — run the tests, each case in its own headless sway (never the session you're in).
#
#   tests/run [all]        scenarios + sequences + resize + keys + focus + cli against ./sway-autotile (~9 min)
#   tests/run scenarios    invariants in normal use, no event loops, tab groups intact
#   tests/run sequences    9 seeded open/focus/close sequences, placement rules checked at every step
#   tests/run resize       windows whose longer side already matches their parent's layout
#   tests/run keys         one key press of a `move` binding moves the window (needs wtype)
#   tests/run focus        one key press of focus parent/child changes the focus on screen (needs wtype);
#                          three times: workspace_open unset (end), = half, = sway (not from CONFIG)
#   tests/run cli          every documented way to run it: --help, --once, --dry-run, --config,
#                          --check-config, warnings, errors
#
# Env: SEEDS="1 2" limits the sequences; KEEP=1 keeps the output dir; CONFIG='key = value' is the
#      config file the program reads in every case but focus, which sets its own (default: none; never
#      the user's own file or any SWAY_AUTOTILE_* variable, which are removed from every case's environment);
#      AUTOTILE_TEST_TERMINAL (default kitty) = the client that opens windows (needs a --title option).
# Needs: sway, python3, kitty (or the terminal above); wtype for `keys` and `focus` (skipped without it).
# shellcheck disable=SC2329  # cleanup and the test functions are called indirectly (trap, "$1")
set -uo pipefail

TESTS=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(dirname "$TESTS")
OUT=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/tmp}" sway-autotile-tests.XXXXXX)
SEEDS=${SEEDS:-"1 2 3 4 5 6 7 8 9"}
export AUTOTILE_TEST_TERMINAL=${AUTOTILE_TEST_TERMINAL:-kitty}
FAILED=0
SWAY_PID=""

for c in sway python3 "${AUTOTILE_TEST_TERMINAL%% *}"; do
    command -v "$c" >/dev/null || { echo "tests/run: $c not found" >&2; exit 2; }
done

# A headless sway with a fixed output and config, software-rendered (no GPU), detached from the
# session this runs in. Sets SWAY_PID, WAYLAND_DISPLAY, SWAYSOCK for the case.
# The placement checks in lib.py depend on this config: GAP there = "gaps inner" here.
start_sway() {
    local dir=$1
    cat >"$dir/config" <<EOF
output HEADLESS-1 mode 2560x1440
default_border pixel 2
gaps inner 8
smart_gaps on
font pango:monospace 10
bindsym Mod4+Shift+h move left
bindsym Mod4+Shift+j move down
bindsym Mod4+Shift+k move up
bindsym Mod4+Shift+l move right
bindsym Mod4+a focus parent
bindsym Mod4+Shift+a focus child
bindsym Mod4+m move container to workspace 9, workspace 9
no_focus [title="^nf"]
exec sh -c 'env | grep -E "^(WAYLAND_DISPLAY|SWAYSOCK)=" > "$dir/env.tmp" && mv "$dir/env.tmp" "$dir/env"'
EOF
    env -u WAYLAND_DISPLAY -u SWAYSOCK -u I3SOCK -u DISPLAY \
        WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1 WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDERER=pixman \
        sway --unsupported-gpu -c "$dir/config" </dev/null >"$dir/sway.log" 2>&1 &
    SWAY_PID=$!
    local i
    for ((i = 0; i < 100; i++)); do
        [[ -f $dir/env ]] && break
        kill -0 "$SWAY_PID" 2>/dev/null || { tail -5 "$dir/sway.log"; return 1; }
        sleep 0.1
    done
    [[ -f $dir/env ]] || return 1
    WAYLAND_DISPLAY=$(sed -n 's/^WAYLAND_DISPLAY=//p' "$dir/env")
    SWAYSOCK=$(sed -n 's/^SWAYSOCK=//p' "$dir/env")
    export WAYLAND_DISPLAY SWAYSOCK
    unset I3SOCK DISPLAY
}

stop_sway() {
    [[ -n $SWAY_PID ]] || return 0
    kill "$SWAY_PID" 2>/dev/null
    wait "$SWAY_PID" 2>/dev/null
    SWAY_PID=""
}

cleanup() {
    stop_sway
    if [[ ${KEEP:-} == 1 ]]; then echo "output kept in $OUT"; else rm -rf "$OUT"; fi
}
trap cleanup EXIT

# case_ NAME SCRIPT ARGS… — fresh sway, event logger, ./sway-autotile --debug, then the test script;
# then sway stops and the daemon must exit with it. DAEMON=0 case_ … starts no daemon (the script runs
# the program itself). Runs in a subshell so the sway sockets never leak into the next case.
# XDG_CONFIG_HOME is the case's own dir and every SWAY_AUTOTILE_* name is removed from the python
# processes' environment (`env -u`, also names that aren't shell identifiers), so the program never
# reads the user's settings; CONFIG='key = value' case_ … writes CONFIG (lines separated by newlines)
# into the config file there, default: no file. AUTOTILE_* variables pass through.
case_() {
    local name=$1; shift
    local daemon=${DAEMON:-1}
    local dir="$OUT/$name"
    mkdir -p "$dir"
    (
        local entry strip=()                 # SWAY_AUTOTILE_* override the config file
        while IFS= read -r -d '' entry; do
            [[ $entry == SWAY_AUTOTILE_* ]] && strip+=(-u "${entry%%=*}")
        done < <(env -0)
        start_sway "$dir" || { echo "FAIL $name: sway did not start"; exit 1; }
        trap stop_sway EXIT
        export XDG_CONFIG_HOME="$dir/xdg"  # after start_sway: the windows sway starts keep the real one
        if [[ -n ${CONFIG:-} ]]; then
            mkdir -p "$XDG_CONFIG_HOME/sway-autotile"
            printf '%s\n' "$CONFIG" >"$XDG_CONFIG_HOME/sway-autotile/config"
        fi
        : >"$dir/events"
        env "${strip[@]}" python3 -B "$TESTS/events.py" "$dir/events" &
        local pid="" rc=0 failed=0
        : >"$dir/autotiler.err"
        if [[ $daemon == 1 ]]; then
            env "${strip[@]}" python3 -B "$ROOT/sway-autotile" --debug 2>"$dir/autotiler.err" &
            pid=$!
        fi
        sleep 1
        AUTOTILE_EVENTS="$dir/events" AUTOTILE_DAEMON_PID="$pid" env "${strip[@]}" python3 -B "$@" >"$dir/out" 2>&1 || rc=$?
        grep -E '^FAIL ' "$dir/out"
        if [[ $rc != 0 ]]; then echo "FAIL $name: test script exited $rc"; tail -3 "$dir/out"; failed=1; fi
        if [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null; then echo "FAIL $name: the autotiler died"; failed=1; fi
        if grep -qE "Traceback|'success': False" "$dir/autotiler.err"; then
            echo "FAIL $name: errors from the autotiler:"
            grep -E "Traceback|'success': False" "$dir/autotiler.err" | head -3
            failed=1
        fi
        if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
            stop_sway                        # "it exits when sway does"
            local i
            for ((i = 0; i < 30; i++)); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
            if kill -0 "$pid" 2>/dev/null; then
                echo "FAIL $name: the autotiler kept running after sway exited"; kill "$pid"; failed=1
            fi
        fi
        local passed; passed=$(grep -c '^PASS' "$dir/out")
        [[ $passed != 0 ]] && echo "     $name: $passed checks passed"
        exit $failed
    ) || FAILED=1
}

scenarios() { echo "== scenarios"; case_ scenarios "$TESTS/scenarios.py"; }

sequences() {
    echo "== sequences (seeds: $SEEDS)"
    local s
    for s in $SEEDS; do case_ "seq-$s" "$TESTS/sequences.py" "$s"; done
}

resize() { echo "== resize"; case_ resize "$TESTS/resize.py"; }

keys() {
    echo "== keys"
    if command -v wtype >/dev/null; then case_ keys "$TESTS/keys.py"; else echo "SKIP keys: wtype not found"; fi
}

focus() {
    echo "== focus"
    if command -v wtype >/dev/null; then
        # The expected mode comes from here, not from the program's loader: a loader bug can't fool both.
        CONFIG='' AUTOTILE_EXPECT_WORKSPACE_OPEN=end case_ focus "$TESTS/focus.py"
        CONFIG='workspace_open = half' AUTOTILE_EXPECT_WORKSPACE_OPEN=half case_ focus-half "$TESTS/focus.py"
        CONFIG='workspace_open = sway' AUTOTILE_EXPECT_WORKSPACE_OPEN=sway case_ focus-sway "$TESTS/focus.py"
    else
        echo "SKIP focus: wtype not found"
    fi
}

cli() { echo "== cli"; DAEMON=0 case_ cli "$TESTS/cli.py"; }

case ${1:-all} in
    all) scenarios; sequences; resize; keys; focus; cli ;;
    scenarios|sequences|resize|keys|focus|cli) "$1" ;;
    *) sed -n '2,18p' "$0"; exit 2 ;;
esac
echo
if [[ $FAILED == 0 ]]; then echo "ALL PASSED"; else echo "SOME TESTS FAILED"; fi
exit $FAILED
