#!/usr/bin/env python3
"""sway-autotile — autotiling for sway that cleans up after itself.

Autotiling: prepare the focused tile for a split along its longer side at startup and after a
focus, close, floating or fullscreen change. Recheck the direction when a window opens, since Sway can resize
the focused tile without a window event. A directional move of a wrapped tile only takes it out of
its wrapper. When a key binding ran that move, it is sent again and the tile wrapped again, so one
press moves the tile. After a move without a binding (swaymsg, scripts), wait for the next open or
focus change before wrapping it again. Floating, fullscreen, tabbed and stacked windows are excluded.
A key's `focus parent`/`focus child` that stops on a one-child wrapper goes on past it, since the
wrapper looks like the window inside: each press moves the focus one level on screen, also when
presses come faster than the daemon reads them. Sway can give focus back to a wrapper a key went past
when you return to a workspace; the window inside gets focus then. A window opened while a key's
`focus parent` has the whole workspace selected goes to the workspace's end, every other con keeping
its size, or takes half the workspace: Sway puts it after the child focused last, which can be in the
middle (option workspace_open). A no_focus window leaves the workspace selected.
The split direction rule comes from autotiling-rs (github.com/ammgws/autotiling-rs).

Cleanup: a split wraps the window in a container with that one window inside. Once focus moves on,
nothing opens there and the wrapper stays — an invisible extra level that makes moving windows,
`layout tabbed` and resizing act on the wrapper instead of what you see. Closing windows leaves the
same kind of one-child containers, sometimes in chains. After every focus/close/move/floating/fullscreen
change every run of one-child split containers is removed with `split none`, except:
  - the focused window's own wrapper (it decides where the next window goes) — chains above it go;
  - runs containing a tabbed/stacked, focused or marked container.
`split none` flattens *every* one-child ancestor above its target, not one level, so it is only
sent when the whole run is plain splith/splitv — a one-tab group is never dissolved.

One process does both, one event after another, so a cleanup can never remove a wrapper made for
a window focused in the meantime (which two separate daemons could). `split`, `layout` and
`split none` on a target emit no window event and move no focus, so nothing loops.

Usage: sway-autotile [--once] [--dry-run] [--debug] [--config PATH]
       sway-autotile --check-config [--config PATH]
  --once           one pass over the current tree, then exit
  --dry-run        print the commands instead of running them
  --debug          log every command to stderr
  --config PATH    read options from PATH instead of the default file (--config=PATH for a path
                   starting with -)
  --check-config   print the options as the daemon would use them (`key = value`), with a warning
                   for each problem; exit 1 if there was one. Needs no sway.
A bad command line (unknown option, --config without a path, with an empty one or given twice) exits 2.

Config file: $XDG_CONFIG_HOME/sway-autotile/config (default ~/.config/sway-autotile/config), optional.
One `key = value` per line; blank lines and lines starting with # are ignored. Options:
  workspace_open = end|half|sway   where a window opened while a focus key has the whole workspace
                                   selected goes: the workspace's end (default), half the workspace
                                   along its longer side, or where Sway puts it
Each option can also be set as SWAY_AUTOTILE_<KEY> (e.g. SWAY_AUTOTILE_WORKSPACE_OPEN=sway), which
wins over the file; an empty one counts as unset. Sway's `exec` passes sway's environment on, so a
variable exported in a shell profile overrides the file. A problem in the file or a variable (an
unknown key or variable, a bad value, a file that can't be read) prints a warning and is skipped:
that option keeps the value it would have without it, and the program runs on.
"""
import errno
import json
import os
import re
import select
import socket
import struct
import sys
import time
from uuid import uuid4

MAGIC = b"i3-ipc"
HEADER = struct.Struct("=6sII")
RUN_COMMAND, SUBSCRIBE, GET_TREE, SEND_TICK = 0, 2, 4, 10
EVENT_WORKSPACE, EVENT_WINDOW, EVENT_BINDING, EVENT_TICK = 0x80000000, 0x80000003, 0x80000005, 0x80000007
TRIGGERS = {"focus", "close", "move", "floating", "fullscreen_mode", "new"}
SPLITS = ("splith", "splitv")
DIRECTIONAL_MOVE = re.compile(
    r"move\s+(?:(?:window|container)\s+)?(left|right|up|down)(?:\s+\d+(?:\s*(?:px|ppt))?)?",
    re.IGNORECASE,
)
MOVE_COMMAND = re.compile(r"\bmove\b", re.IGNORECASE)
FOCUS_LEVEL = re.compile(r"focus\s+(parent|child)", re.IGNORECASE)


def connect():
    path = os.environ.get("SWAYSOCK")
    if not path:
        sys.exit("sway-autotile: SWAYSOCK is not set")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(path)
    except OSError as e:
        s.close()
        sys.exit(f"sway-autotile: {path}: {e.strerror or e}")
    return s


def recv_exact(s, n):
    buf = b""
    while len(buf) < n:
        chunk = s.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("sway closed the IPC socket")
        buf += chunk
    return buf


def send(s, kind, payload=""):
    data = payload.encode()
    s.sendall(HEADER.pack(MAGIC, len(data), kind) + data)


def recv(s):
    magic, length, kind = HEADER.unpack(recv_exact(s, HEADER.size))
    if magic != MAGIC:
        raise ConnectionError("bad IPC magic")
    return kind, json.loads(recv_exact(s, length))


def request(s, kind, payload=""):
    send(s, kind, payload)
    return recv(s)[1]


def workspaces(tree):
    for output in tree["nodes"]:
        for ws in output["nodes"]:
            if ws["type"] == "workspace" and not ws["name"].startswith("__i3"):
                yield ws


def is_wrapper(node):
    """A con holding exactly one tiling child — the thing `split none` removes."""
    return node["type"] == "con" and len(node["nodes"]) == 1


def hidden(node):
    """A one-child split con: on screen it looks exactly like its child."""
    return is_wrapper(node) and node["layout"] in SPLITS and not node.get("marks") and not node.get("fullscreen_mode")


def tree_index(tree):
    """id -> node and id -> parent for every workspace and the tiling cons in it."""
    by_id, parent_of = {}, {}

    def walk(node):
        by_id[node["id"]] = node
        for child in node["nodes"]:
            parent_of[child["id"]] = node
            walk(child)

    for ws in workspaces(tree):
        walk(ws)
    return by_id, parent_of


def workspace_of(parent_of, node):
    """The workspace above `node` (itself for a workspace), from tree_index's parent map."""
    while node["id"] in parent_of:
        node = parent_of[node["id"]]
    return node


def focused_con(tree):
    """The focused workspace or tiling con, or None (floating/none)."""
    return next((n for n in tree_index(tree)[0].values() if n["focused"]), None)


def plan_focus_level(tree, direction, base, exact=False):
    """A key's `focus parent`/`focus child`: (commands, new base, (workspace id, restore id)). The
    press goes one level on screen from `base`, the con focused before it, past hidden cons: otherwise
    a press that lands on the focused window's wrapper shows no change. `base` comes from the event
    stream, since a tree read after the press can already show the next press; it is only trusted if
    the focus now lies in the press's direction from it. `exact`: Sway's focus was on `base` at that
    point of the stream (a window focus event), not only where earlier presses were meant to lead.
    Restore id: a hidden con this press went past (or focuses on the way) that Sway will give the
    focus back to on returning to the workspace, or None. Workspace id None: leave that alone."""
    by_id, parent_of = tree_index(tree)
    now = next((n for n in by_id.values() if n["focused"]), None)
    if not now or (now["type"] == "con" and now.get("fullscreen_mode")):  # a workspace always reports 1
        return [], None, (None, None)  # floating or fullscreen: Sway's behaviour
    up = direction == "parent"
    skipped = set()  # ids of the hidden cons gone past

    def chain(node):
        """The node and its ancestors up to the workspace."""
        out = [node]
        while out[-1]["id"] in parent_of:
            out.append(parent_of[out[-1]["id"]])
        return out

    def past(node):
        while hidden(node):
            skipped.add(node["id"])
            node = parent_of[node["id"]] if up else node["nodes"][0]
        return node

    def sway_step(node):
        """Sway's own step: the parent, or the child focused last. None for a workspace going up, a
        window going down or a fullscreen con."""
        if up:
            fullscreen = node["type"] == "con" and node.get("fullscreen_mode")
            return None if fullscreen else parent_of.get(node["id"])
        children = {c["id"]: c for c in node["nodes"]}
        return next((children[i] for i in node.get("focus", []) if i in children), None)

    def step(node):
        """One press from `node`: Sway's step, then past hidden cons."""
        nxt = sway_step(node)
        return past(nxt) if nxt else node

    start = by_id.get(base)
    if exact and start is now and sway_step(now):
        # Sway's press moved the focus and a later press of the other key took it back before this
        # read (parent, then child: the window focus event comes between their binding events).
        # Going on from here would undo that press. What Sway gives the focus back to is unchanged.
        return [], step(start)["id"], (None, None)
    if start and any(n is (now if up else start) for n in chain(start if up else now)):
        target = new_base = step(start)
        if any(n is (now if up else target) for n in chain(target if up else now)[1:]):
            # Later presses already took the focus beyond this one's target: leave it there. A
            # stale base looks the same (swaymsg focus parent, then this key), and the next key
            # press then starts from this target instead of where the focus is: a known limit.
            target = past(now)
    else:
        target = new_base = past(now)  # focus changed without an event (swaymsg): this press alone
    ws = workspace_of(parent_of, now)["id"]
    if target["type"] == "workspace":
        # Sway gives a workspace's focus back to its child focused last: `top`. If that is a hidden
        # con this press went past, or focuses here on the way, it is the press's, not a choice.
        if target is now:
            top = next((c for c in now["nodes"] if c["id"] in now.get("focus", [])[:1]), None)
            if top and top["id"] in skipped:
                return [], new_base["id"], (ws, top["id"])
            if start is now:
                return [], new_base["id"], (None, None)  # a no-op in Sway: `top` is unchanged
            return [], new_base["id"], (ws, None)
        # A workspace matches no [con_id=]: focus its child above the focus, then its parent.
        top = next(n for n in chain(now) if parent_of.get(n["id"]) is target)
        restore = top["id"] if hidden(top) else None
        return [f"[con_id={top['id']}] focus", "focus parent"], new_base["id"], (ws, restore)
    if target is now:
        return [], new_base["id"], (ws, None)
    return [f"[con_id={target['id']}] focus"], new_base["id"], (ws, None)


def removable(run):
    return all(hidden(n) and not n["focused"] for n in run)


def plan_unwrap(tree):
    """`split none` targets: the node right under each removable run of one-child split cons."""
    targets = []

    def walk(node, ancestors):
        for child in node["nodes"]:  # floating_nodes are left alone on purpose
            walk(child, ancestors + [child])
        if not ancestors:
            return  # the workspace itself
        parent_chain = ancestors[:-1]
        if not parent_chain or not is_wrapper(parent_chain[-1]):
            return  # not under a run (parent has 2+ children, or is the workspace)
        if node["focused"] and not node["nodes"]:
            return  # the focused window: its wrapper stays
        if hidden(node) and not node["focused"] and not (node["nodes"][0]["focused"] and not node["nodes"][0]["nodes"]):
            return  # inside a run, not under it (the focused window's own wrapper ends a run instead)
        run = []
        for anc in reversed(parent_chain):
            if not is_wrapper(anc):
                break
            run.append(anc)
        if removable(run):
            targets.append(node)

    for ws in workspaces(tree):
        walk(ws, [])
    return targets


def focused_tiling(tree):
    """(focused node, its parent) in a workspace's tiling tree, or None (floating/none)."""
    def find(node):
        for child in node["nodes"]:
            if child["focused"]:
                return child, node
            hit = find(child)
            if hit:
                return hit
        return None

    for ws in workspaces(tree):
        hit = find(ws)
        if hit:
            return hit
    return None


def split_target(tree):
    hit = focused_tiling(tree)
    if not hit:
        return None
    node, parent = hit
    if node["nodes"] or node.get("fullscreen_mode") or (node.get("percent") or 0) > 1.0:
        return None
    if parent["layout"] in SPLITS:
        return node, parent


def split_layout(node):
    rect = node["rect"]
    return "splitv" if rect["height"] > rect["width"] else "splith"


def plan_split(node, parent):
    want = split_layout(node)
    if len(parent["nodes"]) >= 2:
        # Wrap it so the next window halves this one, even if the parent already splits this way.
        return f"[con_id={node['id']}] {want}"
    if parent["layout"] == want:
        return None
    if is_wrapper(parent):
        return f"[con_id={node['id']}] layout {want}"
    return f"[con_id={node['id']}] {want}"  # a lone tile can set the workspace layout


def opening_parent(tree, old_id, new_id):
    hit = split_target(tree)
    if not hit:
        return None
    node, parent = hit
    if node["id"] not in (old_id, new_id) or node["nodes"]:
        return None
    siblings = parent["nodes"]
    if any(left["id"] == old_id and right["id"] == new_id and not (left["nodes"] or right["nodes"])
           for left, right in zip(siblings, siblings[1:])):
        return parent
    return None


def orient_pair(parent, old_id):
    # A resize can change the old tile's longer side without sending a window event. Use the
    # combined rectangle of the pair, which still occupies the old tile's space.
    want = split_layout(parent)
    if parent["layout"] == want:
        return []
    if parent["type"] == "workspace":
        # `layout` on a workspace's child wraps all its children in a new con, so it goes to the
        # workspace itself, then focus returns to whichever tile had it.
        focused = next((c["id"] for c in parent["nodes"] if c["focused"]), old_id)
        return [f"[con_id={old_id}] focus parent", f"layout {want}", f"[con_id={focused}] focus"]
    return [f"[con_id={old_id}] layout {want}"]


def plan_open(tree, old_id, new_id):
    parent = opening_parent(tree, old_id, new_id)
    if not parent:
        return [], False
    if len(parent["nodes"]) == 2:
        # Sway may leave focus on the old tile, which then needs to be prepared again.
        old_focused = parent["nodes"][0]["focused"]
        return orient_pair(parent, old_id), old_focused

    # The old tile shared its parent with other tiles before this open. Moving the new tile
    # into a wrapper around the old one restores the siblings' proportions. Keep the parent
    # direction for the move, then check the longer side once the old rectangle is restored.
    mark = f"__sway_autotile_{uuid4().hex}"
    old, new = f"[con_id={old_id}]", f"[con_id={new_id}]"
    commands = [f"{old} {parent['layout']}", f"{old} mark --add {mark}",
                f"{new} move container to mark {mark}", f"{old} unmark {mark}"]
    return commands, True


def plan_append(tree, ws_id, new_id, mode):
    """A window opened while workspace `ws_id` itself was focused: Sway puts it right after the
    workspace's child focused last, which can be in the middle. mode "end": move it to the end, where
    Sway puts it when the last child was focused: outside what was selected, whichever window it came
    from. mode "half": the window takes half the workspace along its longer side, after the rest.
    mode "sway": leave it there. None if it isn't such an open: then it opened beside a tile, which
    may need the open repair. A list, maybe empty, if it is: it never gets that repair."""
    by_id, parent_of = tree_index(tree)
    ws, new = by_id.get(ws_id), by_id.get(new_id)
    if not ws or not new or parent_of.get(new_id) is not ws:
        return None
    if not (new["focused"] or ws["focused"]):
        return None  # the focus went elsewhere meanwhile (a no_focus window): the selection is gone
    if mode == "sway" or ws["layout"] not in SPLITS:
        return []
    cons = [n for n in by_id.values() if n["type"] == "con" and workspace_of(parent_of, n) is ws]
    if any(n.get("fullscreen_mode") for n in cons + ws.get("floating_nodes", [])):
        return []  # a directional move of a fullscreen con goes to the next output
    ids = [c["id"] for c in ws["nodes"]]
    if len(ids) == 1:
        return []  # the workspace held only floating windows: nothing to go after
    # Each child after the window swaps places with it, a view: every con keeps its own size, as if
    # Sway had put the window at the end. Moving the window itself would change the others' sizes.
    back = "left" if ws["layout"] == "splith" else "up"
    commands = [f"[con_id={con_id}] move {back}" for con_id in ids[ids.index(new_id) + 1:]]
    if mode == "half":
        commands += plan_half(ws, new)
    return commands


AXIS = {"splith": "h", "tabbed": "h", "splitv": "v", "stacked": "v"}


def squashable(node, parent_layout):
    """Whether Sway's squash would dissolve `node` or a con below it: a one-child split con across its
    split child, inside a parent that splits along the child's axis (Sway 1.12 container_squash). Sway
    runs it over the whole workspace after every move that takes a con out of its parent."""
    kids = node["nodes"]
    if (len(kids) == 1 and node["layout"] in SPLITS and kids[0]["layout"] in SPLITS
            and node["layout"] != kids[0]["layout"] and AXIS.get(parent_layout) == AXIS[kids[0]["layout"]]):
        return True
    return any(squashable(child, node["layout"]) for child in kids)


def plan_half(ws, new):
    """After plan_append's commands put `new` last: wrap the workspace's other children in one con that
    keeps their layout and sizes, and put `new` after it, half each along the workspace's longer side.
    The focus ends where it was: on `new`, or on the workspace for a no_focus window."""
    want = split_layout(ws)
    refocus = f"[con_id={new['id']}] focus" + ("" if new["focused"] else " parent")
    if len(ws["nodes"]) == 2:
        # One other child: only the direction can be wrong. `layout` on the window would wrap both in
        # a new con, so it goes to the workspace itself.
        return [f"[con_id={new['id']}] focus parent", f"layout {want}", refocus] if ws["layout"] != want else []
    # The move below makes Sway squash the workspace, which would dissolve such a pair, marks and all,
    # and spread its windows. The split keeps every con's parent layout, so this tree tells. Then the
    # window only goes to the end.
    if any(squashable(child, ws["layout"]) for child in ws["nodes"]):
        return []
    # A focused workspace's `split` wraps all its children, the window too, in a con with the
    # workspace's old layout and sizes, and gives the workspace the layout `want`. The window is that
    # con's last child, so a move along `want` takes it out right after the con, whatever its layout.
    return [f"[con_id={new['id']}] focus parent", f"split {want[5]}",
            f"[con_id={new['id']}] move {'right' if want == 'splith' else 'down'}", refocus]


def plan_workspace_refocus(tree, ws_id, new_id):
    """After half's move: with Sway's `workspace_layout tabbed|stacking`, a con moved to the workspace
    level gets a group of its own, so a no_focus window's `focus parent` stopped on that group. Focus
    the workspace again, through the group."""
    by_id, parent_of = tree_index(tree)
    node = focused_con(tree)
    if (node and node["type"] == "con" and parent_of.get(node["id"]) is by_id.get(ws_id)
            and [child["id"] for child in node["nodes"]] == [new_id]):
        return [f"[con_id={node['id']}] focus parent"]
    return []


def run_pass(sock, tree, dry_run, debug, moved=False):
    """Returns (focused tile id or None, its wrapper's slot if the tile is left alone in one)."""
    unwrapped_targets = plan_unwrap(tree)
    commands = [f"[con_id={t['id']}] split none" for t in unwrapped_targets]
    hit = split_target(tree)
    split = plan_split(*hit) if hit and not moved else None
    if split:
        commands.append(split)
    ok = run_commands(sock, commands, dry_run, debug) if commands else True
    if not hit:
        return None, None
    node, parent = hit
    if is_wrapper(parent):
        if ok and any(t["id"] == parent["id"] for t in unwrapped_targets):
            # `split none` removes every contiguous one-child ancestor above `parent`, moving
            # `parent` into the topmost removed ancestor's slot.
            _, parent_of = tree_index(tree)
            top = parent
            while top["id"] in parent_of and is_wrapper(parent_of[top["id"]]):
                top = parent_of[top["id"]]
            return node["id"], slot(tree, top["id"])
        return node["id"], slot(tree, parent["id"])
    if not moved and len(parent["nodes"]) >= 2:
        return node["id"], slot(tree, node["id"]) if ok else None  # its new wrapper takes this place
    return node["id"], None


def slot(tree, con_id):
    """(parent id, index) of a tiling con. A directional move out of a one-child wrapper puts the
    tile where the wrapper was, so the tile's slot tells whether the move moved anything."""
    def find(node):
        for index, child in enumerate(node["nodes"]):
            if child["id"] == con_id:
                return node["id"], index
            hit = find(child)
            if hit:
                return hit
        return None

    for ws in workspaces(tree):
        hit = find(ws)
        if hit:
            return hit
    return None


def run_commands(sock, commands, dry_run, debug):
    if not commands:
        return False
    command = "; ".join(commands)
    if dry_run:
        print(command, flush=True)
        return False
    results = request(sock, RUN_COMMAND, command)
    success = all(r.get("success") for r in results)
    if debug or not success:
        print(f"sway-autotile: {command} -> {results}", file=sys.stderr, flush=True)
    return success


def one_of(*values):
    def parse(value):
        if value not in values:
            raise ValueError(f"expected {', '.join(values[:-1])} or {values[-1]}, got {value!r}")
        return value
    return parse


OPTIONS = {"workspace_open": ("end", one_of("end", "half", "sway"))}  # config key -> (default, parser of its value)
ENV_PREFIX = "SWAY_AUTOTILE_"  # + the key upper-cased: overrides the file


READ_WAIT = 1.0  # seconds a config pipe may take to reach its end, e.g. --config <(…)


def read_text(path):
    """The file's text. A pipe or terminal is read without blocking for good: one that reaches no end
    within READ_WAIT seconds, such as a FIFO with an idle writer or /dev/stdin on a terminal, fails."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)  # opening a FIFO doesn't wait
    try:
        chunks, deadline = [], time.monotonic() + READ_WAIT
        while True:
            try:
                chunk = os.read(fd, 65536)
            except BlockingIOError:
                left = deadline - time.monotonic()
                if left <= 0 or not select.select([fd], [], [], left)[0]:
                    raise OSError(errno.ETIMEDOUT, f"no end of input within {READ_WAIT:g} s (a pipe or terminal?)")
                continue
            if not chunk:
                return b"".join(chunks).decode("utf-8")
            chunks.append(chunk)
    finally:
        os.close(fd)


def load_config(path, warnings):
    """The options from `path`, or from the default file if `path` is None (a missing one is fine).
    Each problem goes to `warnings` and is skipped: a bad line changes nothing, a file that can't be
    read gives the defaults."""
    config = {key: default for key, (default, _) in OPTIONS.items()}
    implicit = path is None
    if implicit:
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
        path = os.path.join(base, "sway-autotile", "config")
    try:
        lines = read_text(path).splitlines()
    except FileNotFoundError as e:
        if not implicit:  # only the default file may be missing; one below an unreadable dir warns
            warnings.append(f"{path}: {e.strerror}")
        return config
    except (OSError, UnicodeDecodeError) as e:
        warnings.append(f"{path}: {getattr(e, 'strerror', None) or e}")
        return config
    for number, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if not sep:
            warnings.append(f"{path}:{number}: expected `key = value`, got {line!r}")
        elif key not in OPTIONS:
            warnings.append(f"{path}:{number}: unknown key {key!r}")
        else:
            try:
                config[key] = OPTIONS[key][1](value)
            except ValueError as e:
                warnings.append(f"{path}:{number}: {key}: {e}")
    return config


def load_options(path, warnings=None):
    """The config file's options, each overridden by its SWAY_AUTOTILE_<KEY> variable if that is set
    and not empty. Problems go to the list `warnings` (if given) and are skipped: a bad variable
    leaves the file's value or the default, an unknown one is ignored."""
    warnings = [] if warnings is None else warnings
    config = load_config(path, warnings)
    for name, value in sorted(os.environ.items()):
        if not name.startswith(ENV_PREFIX) or not value:
            continue
        key = name[len(ENV_PREFIX):].lower()
        if key not in OPTIONS or name != ENV_PREFIX + key.upper():
            warnings.append(f"unknown variable {name} (see --help)")
            continue
        try:
            config[key] = OPTIONS[key][1](value)
        except ValueError as e:
            warnings.append(f"{name}: {e}")
    return config


def usage_error(message):
    """A bad command line: exit 2, so --check-config's 1 only ever means warnings."""
    print(f"sway-autotile: {message}", file=sys.stderr)
    sys.exit(2)


def main():
    argv, args, config_path = sys.argv[1:], set(), None
    while argv:
        arg = argv.pop(0)
        if arg == "--config" or arg.startswith("--config="):
            if config_path is not None:
                usage_error("--config given more than once (see --help)")
            if arg != "--config":
                config_path = arg[len("--config="):]
            elif not argv:
                usage_error("--config needs a path (see --help)")
            elif argv[0].startswith("-"):
                usage_error(f"--config needs a path, got {argv[0]!r} "
                            "(use --config=PATH for a path starting with -)")
            else:
                config_path = argv.pop(0)
        else:
            args.add(arg)
    if config_path == "":  # --config= or --config ''
        usage_error("--config needs a path (see --help)")
    if {"-h", "--help"} & args:
        print("Usage: " + __doc__.split("Usage:")[1].strip())
        return
    unknown = args - {"--once", "--dry-run", "--debug", "--check-config"}
    if unknown:
        usage_error(f"unknown option(s): {' '.join(sorted(unknown))} (see --help)")
    if "--check-config" in args and len(args) > 1:
        others = " ".join(sorted(args - {"--check-config"}))
        usage_error(f"--check-config combines only with --config, got {others} (see --help)")
    dry_run, debug = "--dry-run" in args, "--debug" in args
    warnings = []
    options = load_options(config_path, warnings)
    for warning in warnings:
        print(f"sway-autotile: warning: {warning}", file=sys.stderr, flush=True)
    if "--check-config" in args:
        for key, value in options.items():
            print(f"{key} = {value}")
        sys.exit(1 if warnings else 0)
    workspace_open = options["workspace_open"]

    sock = connect()
    if "--once" in args:
        run_pass(sock, request(sock, GET_TREE), dry_run, debug)
        return

    events = connect()
    if not request(events, SUBSCRIBE, '["workspace", "window", "tick", "binding"]').get("success"):
        sys.exit("sway-autotile: subscribe failed")
    ready_tick = f"sway-autotile-ready:{uuid4().hex}"
    previous = pending = None
    anchor = None     # (tile id, wrapper slot): the tile was wrapped at this point of the event stream
    unwrapped = None  # (tile id, moved nothing) from a move event; a key's binding event comes next

    def prepare(tree, moved=False):
        nonlocal previous
        previous, wrapper = run_pass(sock, tree, dry_run, debug, moved)
        if wrapper and not dry_run:
            # The tree was read before this pass, so a key may have moved the tile since. A tick
            # sent after the split puts the wrapped state at a known point of the event stream.
            request(sock, SEND_TICK, f"{ready_tick} {previous} {wrapper[0]} {wrapper[1]}")

    tree = request(sock, GET_TREE)
    base = focused_con(tree)  # the con focused before the next focus key press, at this point of the stream
    base = base and base["id"]
    exact = True  # `base` is where Sway's focus was (this read, a window focus event), not a key's target
    # workspace id -> the hidden con a focus key went past there and Sway would give the focus back
    # to; dropped on the next window focus on that workspace or the next focus key press there.
    restores = {}
    selected = None  # the workspace a focus key left the focus on; dropped on the next focus elsewhere
    prepare(tree)
    while True:
        kind, event = recv(events)
        if kind == EVENT_WORKSPACE:
            # Handled before `unwrapped` is passed on: a key's move to another workspace or output
            # can put a workspace event between its move event and its binding event.
            ws = (event.get("current") or {}).get("id")
            if event.get("change") == "focus":
                selected = None  # Sway gives the focus to a con on the workspace, not to the workspace
            if event.get("change") == "focus" and ws in restores:
                # Sway gives focus back to the con focused last there, which can be a wrapper a
                # focus key went past. A window opened then would land beside the wrapper instead
                # of halving the window. Focus the window; its focus event prepares it. Only for
                # the wrapper in `restores`: one picked with `swaymsg focus parent` stays. Only
                # while the focus is still there: a later command may have left the workspace
                # already. Sway sends a key's binding event before it runs this command, so the
                # command's focus event comes after it.
                tree = request(sock, GET_TREE)
                parent_of = tree_index(tree)[1]
                node = focused_con(tree)
                if node and node["id"] == restores[ws] and workspace_of(parent_of, node)["id"] == ws:
                    del restores[ws]
                    commands, base, _ = plan_focus_level(tree, "child", None)
                    exact = False
                    run_commands(sock, commands, dry_run, debug)
            continue
        if kind == EVENT_TICK:
            # Handled before `unwrapped` is passed on: a stray tick must not drop a key move's rewrap.
            payload = event.get("payload", "")
            if payload.startswith(ready_tick + " "):
                node_id, parent_id, index = map(int, payload.split()[1:])
                anchor = (node_id, (parent_id, index))
            elif pending and payload == pending[0]:
                token, old_id, new_id, recheck = pending
                pending = None
                tree = request(sock, GET_TREE)
                parent = opening_parent(tree, old_id, new_id)
                if parent and len(parent["nodes"]) == 2:
                    commands = orient_pair(parent, old_id) if recheck else []
                    if commands:
                        if run_commands(sock, commands, dry_run, debug):
                            pending = (token, old_id, new_id, False)
                            request(sock, SEND_TICK, token)
                    else:
                        prepare(tree)
            continue
        if kind == EVENT_WINDOW and event.get("change") not in TRIGGERS:
            continue  # e.g. mark/urgent/title between a move binding's move and binding events
        moved, unwrapped = unwrapped, None
        if kind == EVENT_BINDING:
            command = event["binding"]["command"].strip()
            level = FOCUS_LEVEL.fullmatch(command)
            if level:
                # The key's focus parent/child may have stopped on a wrapper, which looks like the
                # window inside it: go on to the level the user sees. Focusing a con that is no
                # window emits no event; focusing a window emits a focus event, handled as any other.
                tree = request(sock, GET_TREE)
                commands, base, (ws, restore) = plan_focus_level(tree, level[1].lower(), base, exact)
                exact = False
                restores.pop(ws, None)
                if restore:
                    restores[ws] = restore
                node = tree_index(tree)[0].get(base)
                selected = base if node and node["type"] == "workspace" else None
                run_commands(sock, commands, dry_run, debug)
            elif moved and not pending and MOVE_COMMAND.search(command):
                # A key ran `move <dir>` and only took the tile out of its wrapper: move it as the
                # key asked, then wrap it again. Sway sends no binding event for this command.
                node_id, in_place = moved
                tree = request(sock, GET_TREE)
                hit = focused_tiling(tree)
                if in_place and DIRECTIONAL_MOVE.fullmatch(command) and hit and hit[0]["id"] == node_id:
                    if run_commands(sock, [f"[con_id={node_id}] {command}"], dry_run, debug):
                        tree = request(sock, GET_TREE)
                prepare(tree)
            continue
        if kind != EVENT_WINDOW:
            continue
        if event.get("change") == "focus":
            base = event["container"]["id"]  # focus on a con that is no window sends no event
            exact = True
            selected = None
        change, node_id = event["change"], event["container"]["id"]
        if change == "new":
            placed = plan_append(request(sock, GET_TREE), selected, node_id, workspace_open) if selected else None
            if placed is not None:
                # Its focus event, read next, prepares it; the tree read then already shows it moved.
                # "half" ends on the window's own focus command: the same focus event, one more. A
                # no_focus window sends none, and the focus ends on the workspace: it stays selected.
                if run_commands(sock, placed, dry_run, debug) and workspace_open == "half":
                    run_commands(sock, plan_workspace_refocus(request(sock, GET_TREE), selected, node_id),
                                 dry_run, debug)
            elif previous:
                tree = request(sock, GET_TREE)
                commands, follow_up = plan_open(tree, previous, node_id)
                if commands:
                    if run_commands(sock, commands, dry_run, debug) and follow_up:
                        # Re-read the restored rectangle in a separate IPC pass. Focus may stay
                        # on the old tile, so a synthetic event drives the follow-up in both cases.
                        token = f"sway-autotile:{uuid4().hex}"
                        pending = (token, previous, node_id, True)
                        request(sock, SEND_TICK, token)
                elif follow_up:
                    prepare(tree)
            continue
        if pending and node_id == pending[2] and change in ("focus", "move"):
            continue  # the queued tick will prepare the focused tile after the placement check
        tree = request(sock, GET_TREE)
        if change == "focus" and restores:
            # A window focused on a workspace replaces what Sway gives the focus back to there. The
            # pending skip above drops nothing: a stale entry is harmless, since the workspace
            # branch only acts while the focus is on the entry's con.
            by_id, parent_of = tree_index(tree)
            node = by_id.get(node_id)
            if node:
                restores.pop(workspace_of(parent_of, node)["id"], None)
            restores = {w: c for w, c in restores.items() if w in by_id and c in by_id}
        if change == "move":
            # A directional move of a wrapped tile only takes it out of the wrapper, into its slot.
            # A later key press may already have moved it on: then this one counts as a move.
            own = bool(anchor) and anchor[0] == node_id
            unwrapped = (node_id, own and slot(tree, node_id) == anchor[1])
            if own:
                anchor = None
        # Rewrapping on moves would keep the tile in place on later directional moves from swaymsg
        # or scripts, which send no binding event. A key's move is wrapped again on its binding event.
        prepare(tree, moved=change == "move")


if __name__ == "__main__":
    try:
        main()
    except (ConnectionError, KeyboardInterrupt):
        pass
