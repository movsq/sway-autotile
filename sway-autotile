#!/usr/bin/env python3
"""sway-autotile — autotiling for sway that cleans up after itself.

Autotiling: prepare the focused tile for a split along its longer side at startup and after a
focus, close or floating change. Recheck the direction when a window opens, since Sway can resize
the focused tile without a window event. Directional moves can take a tile out of its split, so
wait for the next open or focus change before wrapping it again. Floating, fullscreen, tabbed and
stacked windows are excluded. The split direction rule comes from autotiling-rs
(github.com/ammgws/autotiling-rs).

Cleanup: a split wraps the window in a container with that one window inside. Once focus moves on,
nothing opens there and the wrapper stays — an invisible extra level that makes moving windows,
`layout tabbed` and resizing act on the wrapper instead of what you see. Closing windows leaves the
same kind of one-child containers, sometimes in chains. After every focus/close/move/floating change
every run of one-child split containers is removed with `split none`, except:
  - the focused window's own wrapper (it decides where the next window goes) — chains above it go;
  - runs containing a tabbed/stacked, focused or marked container.
`split none` flattens *every* one-child ancestor above its target, not one level, so it is only
sent when the whole run is plain splith/splitv — a one-tab group is never dissolved.

One process does both, one event after another, so a cleanup can never remove a wrapper made for
a window focused in the meantime (which two separate daemons could). `split`, `layout` and
`split none` on a target emit no window event and move no focus, so nothing loops.

Usage: sway-autotile [--once] [--dry-run] [--debug]
  --once      one pass over the current tree, then exit
  --dry-run   print the commands instead of running them
  --debug     log every command to stderr
"""
import json
import os
import socket
import struct
import sys
from uuid import uuid4

MAGIC = b"i3-ipc"
HEADER = struct.Struct("=6sII")
RUN_COMMAND, SUBSCRIBE, GET_TREE, SEND_TICK = 0, 2, 4, 10
EVENT_WINDOW, EVENT_TICK = 0x80000003, 0x80000007
TRIGGERS = {"focus", "close", "move", "floating", "new"}
SPLITS = ("splith", "splitv")


def connect():
    path = os.environ.get("SWAYSOCK")
    if not path:
        sys.exit("sway-autotile: SWAYSOCK is not set")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(path)
    return s


def recv_exact(s, n):
    buf = b""
    while len(buf) < n:
        chunk = s.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("sway closed the IPC socket")
        buf += chunk
    return buf


def send(s, kind, payload=""):
    data = payload.encode()
    s.sendall(HEADER.pack(MAGIC, len(data), kind) + data)


def recv(s):
    magic, length, kind = HEADER.unpack(recv_exact(s, HEADER.size))
    if magic != MAGIC:
        raise ConnectionError("bad IPC magic")
    return kind, json.loads(recv_exact(s, length))


def request(s, kind, payload=""):
    send(s, kind, payload)
    return recv(s)[1]


def workspaces(tree):
    for output in tree["nodes"]:
        for ws in output["nodes"]:
            if ws["type"] == "workspace" and not ws["name"].startswith("__i3"):
                yield ws


def is_wrapper(node):
    """A con holding exactly one tiling child — the thing `split none` removes."""
    return node["type"] == "con" and len(node["nodes"]) == 1


def removable(run):
    return all(n["layout"] in SPLITS and not n["focused"] and not n.get("marks") for n in run)


def plan_unwrap(tree):
    """`split none` targets: the node right under each removable run of one-child split cons."""
    targets = []

    def walk(node, ancestors):
        for child in node["nodes"]:  # floating_nodes are left alone on purpose
            walk(child, ancestors + [child])
        if not ancestors:
            return  # the workspace itself
        parent_chain = ancestors[:-1]
        if not parent_chain or not is_wrapper(parent_chain[-1]):
            return  # not under a run (parent has 2+ children, or is the workspace)
        if node["focused"]:
            return  # the focused window/container: its wrapper stays
        if is_wrapper(node) and node["layout"] in SPLITS and not node["nodes"][0]["focused"]:
            return  # inside a run, not under it (the focused node's own wrapper ends a run instead)
        run = []
        for anc in reversed(parent_chain):
            if not is_wrapper(anc):
                break
            run.append(anc)
        if removable(run):
            targets.append(node)

    for ws in workspaces(tree):
        walk(ws, [])
    return targets


def focused_tiling(tree):
    """(focused node, its parent) in a workspace's tiling tree, or None (floating/none)."""
    def find(node):
        for child in node["nodes"]:
            if child["focused"]:
                return child, node
            hit = find(child)
            if hit:
                return hit
        return None

    for ws in workspaces(tree):
        hit = find(ws)
        if hit:
            return hit
    return None


def split_target(tree):
    hit = focused_tiling(tree)
    if not hit:
        return None
    node, parent = hit
    if node.get("fullscreen_mode") or (node.get("percent") or 0) > 1.0:
        return None
    if parent["layout"] in SPLITS:
        return node, parent


def split_layout(node):
    rect = node["rect"]
    return "splitv" if rect["height"] > rect["width"] else "splith"


def plan_split(node, parent):
    want = split_layout(node)
    if len(parent["nodes"]) >= 2:
        # Wrap it so the next window halves this one, even if the parent already splits this way.
        return f"[con_id={node['id']}] {want}"
    if parent["layout"] == want:
        return None
    if is_wrapper(parent):
        return f"[con_id={node['id']}] layout {want}"
    return f"[con_id={node['id']}] {want}"  # a lone tile can set the workspace layout


def opening_parent(tree, old_id, new_id):
    hit = split_target(tree)
    if not hit:
        return None
    node, parent = hit
    if node["id"] not in (old_id, new_id) or node["nodes"]:
        return None
    siblings = parent["nodes"]
    if any(left["id"] == old_id and right["id"] == new_id and not (left["nodes"] or right["nodes"])
           for left, right in zip(siblings, siblings[1:])):
        return parent
    return None


def orient_pair(parent, old_id):
    # A resize can change the old tile's longer side without sending a window event. Use the
    # combined rectangle of the pair, which still occupies the old tile's space.
    want = split_layout(parent)
    return [f"[con_id={old_id}] layout {want}"] if parent["layout"] != want else []


def plan_open(tree, old_id, new_id):
    parent = opening_parent(tree, old_id, new_id)
    if not parent:
        return [], False
    if len(parent["nodes"]) == 2:
        # Sway may leave focus on the old tile, which then needs to be prepared again.
        old_focused = parent["nodes"][0]["focused"]
        return orient_pair(parent, old_id), old_focused

    # The old tile shared its parent with other tiles before this open. Moving the new tile
    # into a wrapper around the old one restores the siblings' proportions. Keep the parent
    # direction for the move, then check the longer side once the old rectangle is restored.
    mark = f"__sway_autotile_{uuid4().hex}"
    old, new = f"[con_id={old_id}]", f"[con_id={new_id}]"
    commands = [f"{old} {parent['layout']}", f"{old} mark --add {mark}",
                f"{new} move container to mark {mark}", f"{old} unmark {mark}"]
    return commands, True


def run_pass(sock, tree, dry_run, debug, moved=False):
    commands = [f"[con_id={t['id']}] split none" for t in plan_unwrap(tree)]
    hit = split_target(tree)
    if hit and not moved:
        split = plan_split(*hit)
        if split:
            commands.append(split)
    run_commands(sock, commands, dry_run, debug)
    if hit and not hit[0]["nodes"]:
        return hit[0]["id"]
    return None


def run_commands(sock, commands, dry_run, debug):
    if not commands:
        return False
    command = "; ".join(commands)
    if dry_run:
        print(command, flush=True)
        return False
    results = request(sock, RUN_COMMAND, command)
    success = all(r.get("success") for r in results)
    if debug or not success:
        print(f"sway-autotile: {command} -> {results}", file=sys.stderr, flush=True)
    return success


def main():
    args = set(sys.argv[1:])
    if {"-h", "--help"} & args:
        print("Usage: " + __doc__.split("Usage:")[1].strip())
        return
    unknown = args - {"--once", "--dry-run", "--debug"}
    if unknown:
        sys.exit(f"sway-autotile: unknown option(s): {' '.join(sorted(unknown))} (see --help)")
    dry_run, debug = "--dry-run" in args, "--debug" in args

    sock = connect()
    if "--once" in args:
        run_pass(sock, request(sock, GET_TREE), dry_run, debug)
        return

    events = connect()
    if not request(events, SUBSCRIBE, '["window", "tick"]').get("success"):
        sys.exit("sway-autotile: subscribe failed")
    previous = run_pass(sock, request(sock, GET_TREE), dry_run, debug)
    pending = None
    while True:
        kind, event = recv(events)
        if kind == EVENT_TICK and pending and event.get("payload") == pending[0]:
            token, old_id, new_id, recheck = pending
            pending = None
            tree = request(sock, GET_TREE)
            parent = opening_parent(tree, old_id, new_id)
            if parent and len(parent["nodes"]) == 2:
                commands = orient_pair(parent, old_id) if recheck else []
                if commands:
                    if run_commands(sock, commands, dry_run, debug):
                        pending = (token, old_id, new_id, False)
                        request(sock, SEND_TICK, token)
                else:
                    previous = run_pass(sock, tree, dry_run, debug)
            continue
        if kind != EVENT_WINDOW or event.get("change") not in TRIGGERS:
            continue
        change, node_id = event["change"], event["container"]["id"]
        if change == "new":
            if previous:
                tree = request(sock, GET_TREE)
                commands, follow_up = plan_open(tree, previous, node_id)
                if commands:
                    if run_commands(sock, commands, dry_run, debug) and follow_up:
                        # Re-read the restored rectangle in a separate IPC pass. Focus may stay
                        # on the old tile, so a synthetic event drives the follow-up in both cases.
                        token = f"sway-autotile:{uuid4().hex}"
                        pending = (token, previous, node_id, True)
                        request(sock, SEND_TICK, token)
                elif follow_up:
                    previous = run_pass(sock, tree, dry_run, debug)
            continue
        if pending and node_id == pending[2] and change in ("focus", "move"):
            continue  # the queued tick will prepare the focused tile after the placement check
        # Rewrapping on user moves would keep the tile in place on subsequent directional moves.
        previous = run_pass(sock, request(sock, GET_TREE), dry_run, debug, moved=change == "move")


if __name__ == "__main__":
    try:
        main()
    except (ConnectionError, BrokenPipeError, KeyboardInterrupt):
        pass
